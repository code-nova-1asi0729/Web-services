### Get all equipment
GET {{host}}/api/v1/equipment
Accept-Language: en

### Get equipment by building
GET {{host}}/api/v1/equipment?buildingId=1
Accept-Language: es

### Get equipment by id
GET {{host}}/api/v1/equipment/1
Accept-Language: en

### Modify equipment
PUT {{host}}/api/v1/equipment/1
Content-Type: application/json
Accept-Language: en

{
  "name": "Bomba hidroneumática 1",
  "type": "WATER_PUMP",
  "location": "Sótano 1",
  "installationDate": "2021-03-15",
  "status": "REQUIRES_FOLLOW_UP"
}