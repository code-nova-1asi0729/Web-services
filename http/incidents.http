### Report incident with equipment (201)
POST {{host}}/api/v1/incidents
Content-Type: application/json
Accept-Language: en

{
  "buildingId": 1,
  "residentId": 3,
  "equipmentId": 3,
  "category": "ELEVATOR",
  "description": "El ascensor de la torre A hace un ruido fuerte al subir."
}

### Report incident without equipment (201)
POST {{host}}/api/v1/incidents
Content-Type: application/json
Accept-Language: en

{
  "buildingId": 1,
  "residentId": 4,
  "category": "WATER",
  "description": "Baja presión de agua en los pisos altos por la mañana."
}

### Invalid request (400)
POST {{host}}/api/v1/incidents
Content-Type: application/json
Accept-Language: es

{
  "buildingId": 0,
  "residentId": 3,
  "category": "ELEVATOR",
  "description": "Ruido"
}

### Get all incidents
GET {{host}}/api/v1/incidents
Accept-Language: en

### Get incidents by building
GET {{host}}/api/v1/incidents?buildingId=1
Accept-Language: en

### Get incident by id
GET {{host}}/api/v1/incidents/1
Accept-Language: en

### Get incident that does not exist (404)
GET {{host}}/api/v1/incidents/999
Accept-Language: es

### Start attention (200)
PUT {{host}}/api/v1/incidents/1
Content-Type: application/json
Accept-Language: en

{
  "status": "IN_PROGRESS"
}

### Resolve (200)
PUT {{host}}/api/v1/incidents/1
Content-Type: application/json
Accept-Language: en

{
  "status": "RESOLVED"
}

### Rate with 5 (200)
PUT {{host}}/api/v1/incidents/1
Content-Type: application/json
Accept-Language: en

{
  "status": "RESOLVED",
  "ratingScore": 5,
  "ratingComment": "Lo arreglaron el mismo día."
}

### Go back to reported (409)
PUT {{host}}/api/v1/incidents/1
Content-Type: application/json
Accept-Language: es

{
  "status": "REPORTED"
}

### Rate an incident that is not resolved (409)
PUT {{host}}/api/v1/incidents/2
Content-Type: application/json
Accept-Language: es

{
  "status": "REPORTED",
  "ratingScore": 4
}

### Rating out of range (400)
PUT {{host}}/api/v1/incidents/2
Content-Type: application/json
Accept-Language: en

{
  "status": "IN_PROGRESS",
  "ratingScore": 6
}