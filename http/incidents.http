### Report incident with a device (201)
POST {{host}}/api/v1/incidents
Content-Type: application/json
Accept-Language: en

{
  "buildingId": 1,
  "residentId": 3,
  "deviceId": 3,
  "category": "ELEVATOR",
  "description": "El ascensor de la torre A hace un ruido fuerte al subir."
}

### Report incident without a device (201)
POST {{host}}/api/v1/incidents
Content-Type: application/json
Accept-Language: en

{
  "buildingId": 1,
  "residentId": 4,
  "category": "WATER",
  "description": "Baja presión de agua en los pisos altos por la mañana."
}

### Invalid request (400)
POST {{host}}/api/v1/incidents
Content-Type: application/json
Accept-Language: es

{
  "buildingId": 0,
  "residentId": 3,
  "category": "ELEVATOR",
  "description": "Ruido"
}

### Get all incidents
GET {{host}}/api/v1/incidents
Accept-Language: en

### Get incidents by building
GET {{host}}/api/v1/incidents?buildingId=1
Accept-Language: en

### Get incident by id
GET {{host}}/api/v1/incidents/1
Accept-Language: en

### Get incident that does not exist (404)
GET {{host}}/api/v1/incidents/999
Accept-Language: es

### Start the management of incident 1 (200)
POST {{host}}/api/v1/incidents/1/management-starts
Accept-Language: en

### Start it again (409)
POST {{host}}/api/v1/incidents/1/management-starts
Accept-Language: es

### Resolve incident 1 (200)
POST {{host}}/api/v1/incidents/1/resolutions
Accept-Language: en

### Resolve incident 2 before starting its management (409)
POST {{host}}/api/v1/incidents/2/resolutions
Accept-Language: es

### Rate incident 1 with 5 (200)
POST {{host}}/api/v1/incidents/1/ratings
Content-Type: application/json
Accept-Language: en

{
  "score": 5,
  "comment": "Lo arreglaron el mismo día."
}

### Rate incident 1 again (409)
POST {{host}}/api/v1/incidents/1/ratings
Content-Type: application/json
Accept-Language: es

{
  "score": 4
}

### Rate an incident that is not resolved (409)
POST {{host}}/api/v1/incidents/2/ratings
Content-Type: application/json
Accept-Language: es

{
  "score": 4
}

### Rating out of range (400)
POST {{host}}/api/v1/incidents/2/ratings
Content-Type: application/json
Accept-Language: en

{
  "score": 6
}

### Start the management of an incident that does not exist (404)
POST {{host}}/api/v1/incidents/999/management-starts
Accept-Language: en
